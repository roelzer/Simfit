  "font": {
    "family": {
      "sans": "\"Geist\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "mono": "\"Geist Mono\", ui-monospace, \"SFMono-Regular\", Menlo, monospace"
    },
    "selbst-gehostet": {
      "dateien": "frontend/src/app/fonts/Geist-Variable.woff2 (Pflicht), GeistMono-Variable.woff2 (nur falls tabular-nums bei Geist nicht greift)",
      "einbindung": "next/font/local, display: swap, Lizenz SIL OFL 1.1 als OFL.txt daneben ablegen",
      "verboten": "next/font/google, Google-Fonts-URLs, jede externe Schriftquelle"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "feature": {
      "zahlen": "font-variant-numeric: tabular-nums (Tailwind: tabular-nums) für jede Kennzahl, Tabelle, Uhrzeit, Dauer, Gramm, kcal"
    },
    "size": {
      "caption": { "px": 12, "lineHeight": 16, "weight": 500, "verwendung": "Achsen, Tab-Beschriftung Handy, Quellenhinweis" },
      "small":   { "px": 14, "lineHeight": 20, "weight": 400, "verwendung": "Beschriftungen, Nebeninfos, Tabellen" },
      "body":    { "px": 16, "lineHeight": 24, "weight": 400, "verwendung": "Fließtext, Eingabefelder (16 px verhindert Zoom auf iOS)" },
      "section": { "px": 18, "lineHeight": 26, "weight": 600, "verwendung": "Abschnitts- und Kartentitel" },
      "title":   { "px": 24, "lineHeight": 32, "weight": 600, "letterSpacing": "-0.01em", "verwendung": "Seitentitel (Handy 22/28)" },
      "metric":  { "px": 28, "lineHeight": 32, "weight": 600, "letterSpacing": "-0.02em", "verwendung": "Kennzahlwert (Handy 24/28). Größer gibt es nicht – keine Zahlen-Helden." }
    }
  },
  "space": {
    "skala_px": [0, 4, 8, 12, 16, 24, 32],
    "tailwind": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px" },
    "regeln": {
      "innen-karte": "16 Handy, 24 Desktop",
      "zwischen-karten": "16 Handy, 24 Desktop",
      "zwischen-abschnitten": "32",
      "seitenrand": "16 Handy, 32 Desktop",
      "zeilenhoehe-liste": "mindestens 48 (Tippfläche 44 + Luft)"
    }
  },
  "size": {
    "touch-min_px": 44,
    "control-height_px": { "sm": 36, "md": 44 },
    "icon_px": { "inline": 16, "nav": 20, "tab-handy": 24 },
    "sidebar_px": { "voll": 232, "schmal": 72 },
    "bottom-tabs_px": 64,
    "content-max_px": 1120,
    "dialog-max_px": 520,
    "sheet-desktop_px": 480
  },
  "breakpoint_px": {
    "handy": "bis 767 (untere Tab-Leiste)",
    "md": 768,
    "lg": 1024,
    "testbreiten": [390, 1440]
  },
  "radius_px": {
    "control": 8,
    "card": 12,
    "dialog": 12,
    "pill": 9999
  },
  "border": {
    "width_px": 1,
    "regel": "Karten haben Linie (border), keinen Schatten. Schatten nur für schwebende Elemente."
  },
  "shadow": {
    "none": "none",
    "float": "0 8px 24px -8px rgb(0 0 0 / 0.18), 0 2px 6px -2px rgb(0 0 0 / 0.08)",
    "float-dark": "0 8px 24px -8px rgb(0 0 0 / 0.6)",
    "verwendung": "nur Popover, Dropdown, Dialog, Sheet, Toast"
  },
  "motion": {
    "duration_ms": { "fast": 150, "base": 200 },
    "easing": "cubic-bezier(0.2, 0, 0, 1)",
    "reduced": "Bei prefers-reduced-motion: reduce alle Dauern 0 ms, Recharts isAnimationActive=false, Skeleton ohne Pulsieren"
  },
  "focus": {
    "ring_px": 2,
    "offset_px": 2,
    "farbe": "ring",
    "regel": "focus-visible auf jedem bedienbaren Element, nie outline: none ohne Ersatz"
  },
  "z": { "nav": 30, "banner": 20, "sheet": 50, "dialog": 50, "toast": 60 }
}
