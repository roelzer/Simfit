# demo = Fake-Daten ohne Garmin-Konto, garmin = echte Garmin-Connect-Cloud
SIMFIT_SOURCE=demo
DATABASE_URL=sqlite:///./simfit.db
# Nur für `python -m app.garmin_login` (Zugangsdaten werden nicht gespeichert, nur Tokens)
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKENSTORE=~/.simfit/garmin
CORS_ORIGINS=http://localhost:3000
